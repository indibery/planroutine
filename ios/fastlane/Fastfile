default_platform(:ios)

require "tmpdir"

# ── 공통 헬퍼 ──
# TAGO 인증키를 리포 밖에서 읽는다.
#
# 키를 못 읽으면 레인을 실패시킨다 — 키 없이 빌드하면 버스 기능이 조용히 죽은
# 앱이 스토어에 올라간다. 화면에는 "버스 정보를 불러올 수 없어요"만 뜨고
# 사용자는 원인을 알 수 없다.
def tago_key
  path = File.expand_path("~/.planroutine/tago.env")
  UI.user_error!("TAGO 키 파일이 없습니다: #{path}") unless File.exist?(path)

  key = File.readlines(path)
           .map(&:strip)
           .find { |l| l.start_with?("TAGO_KEY_DECODING=") }
           &.split("=", 2)
           &.last
           &.strip

  if key.nil? || key.empty?
    UI.user_error!("TAGO_KEY_DECODING 이 비어 있습니다: #{path}")
  end
  key
end

# 빌드가 끝나면 키가 되돌아온 두 파일을 지운다.
#
# `--dart-define-from-file`로 넘겨 argv·로그 echo에서는 키가 사라지지만, flutter는
# **모든 dart-define을 base64 CSV로 리포 안 두 파일에 다시 쓴다** —
# `ios/Flutter/Generated.xcconfig`(0644)와 `ios/Flutter/flutter_export_environment.sh`(0755).
# 즉 0700 임시 디렉터리의 보호는 빌드 시점까지이고, 그 뒤에는 world-readable 파일 2개가
# 다음 `flutter clean`(= 다음 beta의 `reset_ios_caches`)까지 키를 들고 있다.
# 폴더 압축·백업·에이전트 grep·실수로 `git add -f` 하는 순간이 곧 유출이다.
#
# 다음 flutter 명령이 어차피 재생성하므로 지우는 비용은 0이다. IPA는 이미 만들어졌고
# 이 레인의 남은 단계(IPA 탐색·업로드)는 이 파일들을 읽지 않는다.
def strip_dart_defines
  ios_dir = File.expand_path("..", __dir__)
  targets = [
    File.join(ios_dir, "Flutter/Generated.xcconfig"),
    File.join(ios_dir, "Flutter/flutter_export_environment.sh"),
  ]
  removed = targets.count { |f| File.exist?(f) && (File.delete(f) == 1) }
  UI.message("키가 재기록되는 빌드 설정 파일 #{removed}개를 지웠다")
end

# 함정 #6 회피: 통합 테스트(시뮬 빌드)가 남긴 native_assets 시뮬 슬라이스가
# 디바이스 IPA에 묶이면 altool 91169("Simulator platforms aren't permitted")로
# 거부된다. flutter clean + Pods/build 제거로 캐시를 비우고, 이어지는
# `flutter build ipa`가 pub get + pod install을 재수행해 클린 재구성한다.
# (바로팀과 달리 공직플랜은 flutter build ipa가 pod install을 직접 처리하므로
#  명시적 pod install·GEM unset(#7)은 불필요.)
def reset_ios_caches
  UI.header("iOS 캐시 정리 — 시뮬 슬라이스 방지 (함정 #6)")
  # __dir__ = ios/fastlane → 두 단계 위가 프로젝트 루트.
  project_root = File.expand_path("../..", __dir__)
  Dir.chdir(project_root) do
    sh("flutter", "clean")
    sh("rm", "-rf", "ios/Pods", "ios/Podfile.lock", "ios/build")
  end
end

# pubspec.yaml의 versionString(X.Y.Z) 파싱. 빌드 이름은 이 값을 그대로 쓴다
# (레인이 --build-name을 안 넘기므로 flutter가 pubspec 버전을 사용).
def pubspec_version_name
  project_root = File.expand_path("../..", __dir__)
  pubspec = File.read(File.join(project_root, "pubspec.yaml"))
  match = pubspec.match(/^version:\s*(\d+\.\d+\.\d+)/)
  UI.user_error!("pubspec.yaml에서 version을 찾을 수 없습니다") unless match
  match[1]
end

# ── App Store Connect 공통 ──
APP_BUNDLE_ID = "com.planroutine.app"

# 스크린샷/메타데이터를 고쳐도 안전한 상태. 이 목록 밖은 심사가 진행 중이라는 뜻이다.
EDITABLE_STATES = %w[
  PREPARE_FOR_SUBMISSION
  DEVELOPER_REJECTED
  REJECTED
  METADATA_REJECTED
].freeze

# 인증 + 앱 조회. 레인마다 세 줄씩 반복하던 것을 한곳으로.
def asc_app(api_key)
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find(APP_BUNDLE_ID)
  UI.user_error!("앱을 찾을 수 없습니다: #{APP_BUNDLE_ID}") if app.nil?
  app
end

# 업로드한 빌드가 실제로 TestFlight에 **도착했는지** 확인한다.
#
# `upload_to_testflight`의 성공은 Transporter가 패키지를 받은 것까지다. 그 뒤
# Apple의 에셋 검증에서 거부되면 빌드가 ASC에 나타나지 않고, 사유는
# `TestFlight › 빌드 업로드` 화면과 계정 메일에만 남는다. `skip_waiting_for_
# build_processing: true`라 레인은 그 결과를 보지 않으므로, 여기서 직접 본다.
#
# 실패 모드가 둘이라 분기도 둘이다.
#   - 빌드가 나타났지만 INVALID/FAILED → 즉시 실패(기다릴 이유가 없다)
#   - 아예 나타나지 않음 → 타임아웃까지 기다린 뒤 실패(검증 거부의 실제 모습이다)
def assert_build_arrived(api_key, build_number, timeout_min: 20)
  app = asc_app(api_key)
  deadline = Time.now + (timeout_min * 60)
  loop do
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, limit: 20, sort: "-uploadedDate"
    )
    found = builds.find { |b| b.version.to_s == build_number.to_s }
    if found
      state = found.processing_state
      UI.message("빌드 v#{build_number} 처리 상태: #{state}")
      return true if state == "VALID"
      if %w[INVALID FAILED].include?(state)
        UI.user_error!(
          "빌드 v#{build_number}가 #{state}입니다. ASC의 " \
          "'TestFlight › 빌드 업로드'에서 오류를 확인하세요."
        )
      end
    else
      UI.message("빌드 v#{build_number} 아직 미도착 — 기다립니다...")
    end

    if Time.now > deadline
      UI.user_error!(
        "빌드 v#{build_number}가 #{timeout_min}분 안에 TestFlight에 나타나지 " \
        "않았습니다. 업로드는 수락됐지만 Apple 처리에서 거부된 것으로 보입니다 — " \
        "ASC의 'TestFlight › 빌드 업로드' 오류와 계정 메일을 확인하세요. " \
        "(실측 사례: 90683 Missing purpose string in Info.plist)"
      )
    end
    sleep(30)
  end
end

# 편집 중(제출 준비 중) 버전. 없으면 nil — 조회 실패도 nil로 접는다.
def edit_version(app)
  app.get_edit_app_store_version
rescue StandardError
  nil
end

# 편집 가능한 버전 페이지를 보장한다(없으면 생성).
#
# minor/major를 올릴 때는 항상 없다 — 자동화하지 않으면 매번 사람이 ASC에서
# '+ 버전 또는 플랫폼'을 눌러야 한다. patch는 기존 페이지가 남아 그냥 통과한다.
# 없는 채로 upload_to_app_store에 들어가면 fastlane 2.233.0이 sync_app_previews에서
# NoMethodError로 죽어 원인을 읽을 수 없다.
def ensure_edit_version(app, version_string)
  edit = edit_version(app)
  return edit if edit

  UI.message("편집 가능한 버전 없음 → #{version_string} 페이지를 생성합니다")
  app.ensure_version!(version_string, platform: Spaceship::ConnectAPI::Platform::IOS)

  edit = edit_version(app)
  if edit.nil?
    UI.user_error!("#{version_string} 버전 페이지 생성 실패. ASC에서 직접 만든 뒤 재실행하세요.")
  end
  UI.success("버전 페이지 생성: #{edit.version_string}")
  edit
end

# [가드] 심사에 들어간 버전은 건드리지 않는다 — 건드리면 심사가 되돌려진다.
def assert_editable(edit, action)
  state = edit.app_store_state
  unless EDITABLE_STATES.include?(state)
    UI.user_error!(
      "#{edit.version_string}이(가) '#{state}' 상태입니다. #{action}을 실행하면 " \
      "진행 중인 심사가 되돌려질 수 있습니다. 심사를 기다리는 중이면 아무것도 하지 마세요. " \
      "정말 바꿔야 하면 `withdraw_review`로 철회한 뒤 재실행하세요(대기열 처음으로)."
    )
  end
  UI.success("편집 가능 상태 확인: #{edit.version_string} (#{state})")
end

# [가드] "이번 버전의 새로운 기능"을 docs/release_notes/<버전>.ko.txt에서 넣는다.
# Apple이 업데이트 심사에 필수로 요구하므로, 비어 있으면 어차피 제출이 막힌다.
def apply_release_notes(edit)
  version_string = edit.version_string
  project_root = File.expand_path("../..", __dir__)
  path = File.join(project_root, "docs/release_notes/#{version_string}.ko.txt")

  unless File.exist?(path)
    UI.user_error!(
      "릴리즈 노트가 없습니다 → docs/release_notes/#{version_string}.ko.txt " \
      "(Apple 필수 항목. docs/release_notes/README.md 참고)"
    )
  end
  notes = File.read(path).strip
  UI.user_error!("릴리즈 노트가 비어 있습니다: #{path}") if notes.empty?

  locs = edit.get_app_store_version_localizations
  UI.user_error!("버전 로컬라이제이션이 없습니다.") if locs.empty?
  locs.each { |loc| loc.update(attributes: { whats_new: notes }) }
  UI.success("릴리즈 노트 반영: #{locs.map(&:locale).join(', ')} (#{notes.lines.count}줄)")
end

# 문서(.md)의 첫 ```text 블록을 스토어 문구로 뽑는다.
#
# 설명·심사 메모의 단일 출처를 리포에 두기 위한 장치. 마크다운 본문(설명·주의사항)은
# 블록 밖에 있고, 스토어에 들어갈 글만 블록 안에 있다.
# 잘못 파싱해 반쪽짜리 글이 스토어에 올라가면 사용자가 본다 → 검증을 거친다.
def extract_store_text(relative_path, label, min_length)
  project_root = File.expand_path("../..", __dir__)
  path = File.join(project_root, relative_path)
  UI.user_error!("#{label} 문서가 없습니다 → #{relative_path}") unless File.exist?(path)

  body = File.read(path)
  match = body.match(/```text\n(.*?)```/m)
  UI.user_error!(
    "#{label}에서 ```text 블록을 찾지 못했습니다 → #{relative_path} " \
    "(스토어에 들어갈 글은 ```text 블록 안에 둔다)"
  ) if match.nil?

  text = match[1].strip
  if text.length < min_length
    UI.user_error!(
      "#{label}이 너무 짧습니다(#{text.length}자 < #{min_length}자) — 파싱이 깨졌을 수 있습니다: #{relative_path}"
    )
  end
  if text.include?("```") || text.start_with?("#")
    UI.user_error!("#{label} 파싱 결과에 마크다운이 섞였습니다: #{relative_path}")
  end
  text
end

# 스토어 설명 + 심사 메모를 리포 기준으로 맞춘다.
#
# 리포가 단일 출처다 — ASC에서 직접 고친 내용은 여기서 덮어써진다. 그래야 "코드에서
# 기능을 뺐는데 스토어 설명은 그대로 남는" 어긋남이 생기지 않는다.
# 바뀐 항목만 로그로 남겨 무엇이 갱신됐는지 보이게 한다.
def apply_store_metadata(edit)
  description = extract_store_text("docs/app_store_description.md", "App Store 설명", 400)
  notes = extract_store_text("docs/app_review_notes.md", "심사 메모", 200)

  # 설명 — 로케일별 로컬라이제이션
  edit.get_app_store_version_localizations.each do |loc|
    if loc.description.to_s.strip == description
      UI.message("설명 #{loc.locale}: 변경 없음")
    else
      loc.update(attributes: { description: description })
      UI.success("설명 #{loc.locale}: 갱신 (#{description.length}자)")
    end
  end

  # 심사 메모 — 버전당 하나(App Review Information)
  detail = begin
    edit.fetch_app_store_review_detail
  rescue StandardError => e
    UI.important("심사 메모 조회 실패(#{e.class}) — ASC에서 직접 확인하세요")
    nil
  end
  return if detail.nil?

  if detail.notes.to_s.strip == notes
    UI.message("심사 메모: 변경 없음")
  else
    detail.update(attributes: { notes: notes })
    UI.success("심사 메모: 갱신 (#{notes.length}자)")
  end
end

# 업로드된 스크린샷을 (슬롯, 스크린샷 배열)로 순회한다. 조회·정리가 공유.
def each_screenshot_set(edit)
  edit.get_app_store_version_localizations.each do |loc|
    sets = loc.get_app_screenshot_sets.sort_by { |st| st.screenshot_display_type.to_s }
    sets.each { |st| yield(loc, st, st.app_screenshots || []) }
  end
end

# 파일명이 같은 중복을 첫 장만 남기고 지운다.
#
# deliver가 병렬 업로드 중 같은 파일을 두 번 올리는 일이 있다(실측: 10장 → 13장).
# 전체 재업로드는 같은 경합이 재발하므로 중복만 도려낸다. 몇 번 돌려도 안전하다.
def dedupe_screenshots!(edit)
  removed = 0
  each_screenshot_set(edit) do |_loc, st, shots|
    seen = {}
    shots.each do |sh|
      if seen[sh.file_name]
        UI.message("  중복 삭제: #{st.screenshot_display_type} / #{sh.file_name}")
        sh.delete!
        removed += 1
      else
        seen[sh.file_name] = true
      end
    end
  end
  UI.success(removed.zero? ? "스크린샷 중복 없음" : "스크린샷 중복 #{removed}장 삭제")
  removed
end

def next_patch(version)
  parts = version.split(".").map(&:to_i)
  parts[2] = (parts[2] || 0) + 1
  parts.join(".")
end

# 함정 #5 선제 차단: pubspec versionString이 App Store 승인본(현재 판매 중 버전)
# 이하이면 그 train이 닫혀 있어 altool이 업로드를 거부한다(90062/90186).
# clean 빌드(수 분) + 업로드까지 다 돌린 뒤 거부당하는 낭비를 막으려고,
# 빌드 전에 즉시 NO-GO로 중단한다. 버전 자동 증가는 하지 않는다 — 증가폭은 사람 판단.
# [가드] pubspec versionString이 App Store 승인본 이하이면 그 train이 닫혀 있어
# altool이 업로드를 거부한다(90062/90186). clean 빌드(수 분) + 업로드까지 다 돌린 뒤
# 거부당하는 낭비를 막으려고 빌드 전에 중단한다.
# 버전 자동 증가는 하지 않는다 — 증가폭(patch/minor/major)은 사람 판단.
def assert_version_bumped(app)
  live = app.get_live_app_store_version
  local = pubspec_version_name

  if live.nil?
    UI.message("App Store 승인본 없음 — 버전 가드 통과 (pubspec #{local})")
    return
  end

  approved = live.version_string
  if Gem::Version.new(local) > Gem::Version.new(approved)
    UI.success("버전 가드 통과: pubspec #{local} > 승인본 #{approved}")
  else
    UI.user_error!(
      "pubspec 버전 #{local}이(가) App Store 승인본 #{approved} 이하입니다. " \
      "이 train은 닫혀 있어 업로드가 거부됩니다. " \
      "pubspec.yaml의 version을 올리세요 (예: #{next_patch(approved)})."
    )
  end
end

platform :ios do

  # ── App Store Connect API Key 인증 ──
  desc "App Store Connect API Key 로드"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: "D8W86CLKHY",
      issuer_id: "69a6de72-97eb-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_D8W86CLKHY.p8"),
    )
  end

  # 키 가드만 밟아 본다 — 배포를 트리거하지 않고 확인할 수 있어야 한다.
  #
  # beta로 확인하면 ASC 인증 + 버전 가드 + TestFlight 조회 + 파괴적 clean을 전부
  # 지난 뒤에야 키에 도달한다(수 분 + Pods 삭제). 값싼 가드는 값싸게 밟을 수 있어야
  # 실제로 밟힌다.
  desc "TAGO 키 파일만 확인한다 (배포·빌드·clean 없음)"
  lane :check_tago_key do
    key = tago_key
    UI.success("TAGO 키 OK: #{key.length}자")
  end

  # ── TestFlight 배포 ──
  desc "TestFlight에 새 빌드 업로드"
  lane :beta do
    api_key = load_asc_api_key

    # 승인본 이하 버전이면 clean 빌드 전에 중단
    assert_version_bumped(asc_app(api_key))

    # 키를 clean 앞에서 읽는다 — 값싼 가드를 파괴적 단계 앞에 모으는 이 레인의 규칙
    # 그대로다(`reset_ios_caches`는 flutter clean + Pods/Podfile.lock/ios/build 삭제라
    # 수 분이 걸리고 되돌릴 수 없다). 키를 깜빡한 배포가 캐시를 날린 뒤 실패하면
    # 가드가 있는 의미가 없다.
    key = tago_key
    UI.message("TAGO 키: #{key.length}자 주입")

    # 빌드 번호 자동 증가 (TestFlight 최신 빌드 + 1)
    latest = latest_testflight_build_number(app_identifier: APP_BUNDLE_ID)
    new_build_number = latest + 1
    UI.message("빌드 번호: #{latest} → #{new_build_number}")

    reset_ios_caches

    # Flutter 빌드
    Dir.mktmpdir do |tmp|
      # 키를 argv에 실으면 fastlane이 그대로 로그에 남긴다 — `sh`는 기본이
      # `log: true`이고 실행 **전에** 명령 문자열을 그대로 찍는다(sh_helper의
      # `UI.command(shell_command)`), 실패 시 에러 메시지에도 같은 문자열이 들어간다.
      # 이 리포의 배포 관례가 전문 로그를 파일로 남기므로 그대로 두면 64자 키가
      # 평문으로 보관된다. 파일 경로만 넘기면 echo·에러 양쪽에서 키가 사라지고
      # 빌드 출력은 그대로 보인다(`log: false`는 출력까지 함께 끈다).
      #
      # 파일은 리포 밖 시스템 임시 디렉터리(0700)에 만들고 블록이 끝나면 지워진다.
      # **다만 그 보호는 빌드 시점까지다** — flutter가 키를 리포 안으로 되돌려
      # 쓰므로 블록 뒤의 정리가 짝이다(아래 `strip_dart_defines`).
      define_file = File.join(tmp, "tago.json")
      File.write(define_file, JSON.generate({ "TAGO_KEY" => key }))

      Dir.chdir("..") do
        sh("flutter", "build", "ipa",
          "--release",
          "--build-number=#{new_build_number}",
          "--dart-define-from-file=#{define_file}",
        )
      end
    end

    strip_dart_defines

    # IPA 파일명이 한글(공직플랜.ipa)이라 Ruby Dir[] glob이 매치 못함. Dir.entries로
    # 직접 순회해 찾는다. 파일명이 또 바뀌어도 깨지지 않는다.
    # __dir__ = ios/fastlane → 두 단계 올라가 프로젝트 루트.
    project_root = File.expand_path("../..", __dir__)
    ipa_dir = File.join(project_root, "build/ios/ipa")
    ipa_name = Dir.entries(ipa_dir).find { |f| f.end_with?(".ipa") }
    UI.user_error!("빌드된 IPA를 찾을 수 없습니다 (#{ipa_dir})") unless ipa_name
    ipa_path = File.join(ipa_dir, ipa_name)

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )

    # [가드] 업로드 성공은 **Transporter가 패키지를 받았다**까지다. Apple의 처리
    # (에셋 검증)에서 거부되면 빌드가 ASC에 **아예 나타나지 않는다**.
    #
    # 실측(2026-08-03 v143): 레인이 `Successfully uploaded package`를 찍고
    # 성공으로 끝났는데 3시간 뒤에도 TestFlight 최신은 v142였다. 사유는
    # `90683 Missing purpose string in Info.plist`(NSCameraUsageDescription)로,
    # ASC의 `TestFlight › 빌드 업로드`에서만 볼 수 있었다. 이 조용한 실패를
    # 큰 소리로 바꾼다 — 도착을 확인하고 못 오면 레인을 실패시킨다.
    assert_build_arrived(api_key, new_build_number)

    UI.success("TestFlight 배포 완료! v#{new_build_number}")
  end

  # ── App Store 심사 준비 ───────────────────────────────────────
  #
  #   fastlane ios release build:115           승격 + 노트 + 스크린샷 (제출 안 함)
  #   fastlane ios release                     승격 대상을 최신으로 (권장하지 않음)
  #   fastlane ios release shots:false         스크린샷 건너뛰기
  #   fastlane ios release submit:true         제출까지 자동 (명시해야만)
  #
  # 재빌드/재업로드가 없다 — 실기기로 검증한 그 바이너리가 그대로 심사에 간다.
  # **기본값은 제출하지 않는다.** 최종 '심사를 위해 제출'은 사람이 ASC에서 누른다.
  #
  # 순서: 버전 확인 → 버전 페이지 → 편집 가능 확인 → 릴리즈 노트
  #       → 빌드 확인 → (스크린샷 + 빌드 연결) → 중복 정리
  desc "App Store 심사 준비 — 빌드 승격 + 릴리즈 노트 + 스크린샷 (제출은 사람이)"
  lane :release do |options|
    api_key = load_asc_api_key
    app = asc_app(api_key)

    assert_version_bumped(app)
    edit = ensure_edit_version(app, pubspec_version_name)
    assert_editable(edit, "release")
    apply_release_notes(edit)
    # 스토어 설명 + 심사 메모도 리포 기준으로 맞춘다(리포가 단일 출처).
    apply_store_metadata(edit)

    # 승격 대상. 빌드를 명시하면 그것만 쓴다 — "최신"에 맡기면 실기기 검증 후
    # beta를 한 번 더 돌렸을 때 검증하지 않은 빌드가 심사에 올라간다.
    target =
      if options[:build]
        options[:build].to_s.to_i
      else
        latest_testflight_build_number(
          app_identifier: APP_BUNDLE_ID,
          version: edit.version_string,
        )
      end

    # [가드] 그 빌드가 ASC에 VALID로 있어야 승격 가능.
    # 방금 beta로 올렸으면 처리(40~60분)가 끝나야 VALID가 된다.
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 20, sort: "-uploadedDate")
    target_build = builds.find { |b| b.version.to_i == target && b.processing_state == "VALID" }
    if target_build.nil?
      UI.user_error!(
        "build #{target}이 App Store Connect에 VALID로 없습니다(처리 중일 수 있음). " \
        "`check_builds`로 VALID 확인 후 재실행하세요."
      )
    end
    UI.success("승격 대상 확인: build #{target} (#{edit.version_string})")

    # 스크린샷은 기본 포함. deliver가 **이미지 크기로** 기기 슬롯을 판단하므로
    # 파일명에 규격을 붙여 두 세트를 함께 둔다(6.5_* = 1284x2778, 6.9_* = 1320x2868).
    # 파일명 순서가 노출 순서다.
    shots_dir = File.expand_path("screenshots", __dir__)
    shots_count = Dir.glob(File.join(shots_dir, "**", "*.png")).count
    with_shots = !%w[false no 0].include?(options[:shots].to_s.downcase) && shots_count.positive?
    if with_shots
      UI.message("스크린샷 #{shots_count}장 포함 → #{shots_dir}")
    elsif shots_count.zero?
      UI.important("스크린샷 없음(#{shots_dir}) — 기존 것이 그대로 유지됩니다")
    else
      UI.important("스크린샷 건너뜀 (shots:false)")
    end

    submit = %w[true yes 1].include?(options[:submit].to_s.downcase)

    # 빌드 연결 + 스크린샷을 한 번의 deliver 호출로 처리한다(두 번 부르면 느리고,
    # 중간 상태가 생겨 어디서 실패했는지 읽기 어렵다).
    upload_to_app_store(
      api_key: api_key,
      build_number: target.to_s,
      skip_binary_upload: true,   # 재업로드 없음 — 기존 빌드 승격만
      skip_metadata: true,        # 리스팅 문구는 ASC에서 관리(노트는 위에서 넣었다)
      skip_screenshots: !with_shots,
      overwrite_screenshots: with_shots,
      screenshots_path: with_shots ? shots_dir : nil,
      submit_for_review: submit,
      automatic_release: true,    # 승인 시 자동 공개
      force: true,                # HTML 미리보기 확인 스킵(비대화형)
      # precheck는 ASC API Key로 IAP 확인이 안 돼 에러가 난다 → 끈다.
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
      },
    )

    # 업로드 직후 중복 정리 — deliver의 병렬 업로드가 같은 파일을 두 번 올릴 수 있다.
    dedupe_screenshots!(edit) if with_shots

    # [승격의 본체] 빌드 연결을 deliver에 맡기지 않는다.
    #
    # deliver는 `build_number`를 받아도 **제출 흐름 안에서만** 빌드를 고른다 —
    # `submit_for_review: false`면 그 단계를 통째로 건너뛴다. 그래서 로그에는
    # `build_number | 124`가 찍히고 deliver도 성공으로 끝나는데, 편집 버전의
    # 선택된 빌드는 옛것 그대로 남는다(실측: v124를 넘겼는데 v115 유지).
    # "제출은 사람이 누른다"가 이 레인의 기본값이므로 그 경로가 곧 정상 경로다 —
    # 여기서 직접 붙이지 않으면 release는 사실상 메타데이터만 동기화한다.
    selected = begin
      (edit_version(app) || edit).select_build(build_id: target_build.id)
    rescue StandardError => e
      UI.user_error!(
        "빌드 연결 실패(#{e.class}: #{e.message}) — " \
        "ASC → 공직플랜 → #{edit.version_string} → '빌드' 에서 직접 고르세요."
      )
    end
    UI.success("빌드 연결: v#{selected&.build&.version || target}")

    # 의도가 아니라 **실제 상태**를 다시 읽어 보고한다.
    #
    # submit:false로 돌려도 심사 대기열에 들어가는 경우가 있다 — 한 번 제출했다가
    # withdraw_review로 내린 버전(DEVELOPER_REJECTED)에 빌드를 다시 연결하면
    # ASC가 이전 제출을 복원한다(실측). "제출 안 했다"고 단정하면 거짓이 된다.
    final = edit_version(app) || edit
    in_queue = !EDITABLE_STATES.include?(final.app_store_state)

    UI.success("완료 — #{final.version_string} / build #{target} / 상태 #{final.app_store_state}")
    if in_queue
      UI.success("심사 대기열에 있습니다 — 승인 시 자동 공개")
      UI.important("의도와 다르면 `withdraw_review`로 내릴 수 있습니다") unless submit
    else
      UI.important("아직 제출되지 않았습니다. 남은 한 단계는 사람이 누릅니다:")
      UI.important("  ASC → 공직플랜 → #{final.version_string} → '심사를 위해 제출'")
    end
    UI.important("확인: `asc_state` (상태·빌드·스크린샷 한눈에)")
  end

  # ── 심사 철회 ─────────────────────────────────────────────────
  #
  #   fastlane ios withdraw_review
  #
  # 제출한 심사를 내려 편집 가능한 상태로 되돌린다. 스크린샷·노트를 고쳐 다시 올릴 때만.
  # ⚠️ 대기열 처음으로 돌아간다 — 이미 IN_REVIEW면 손실이 더 크다.
  desc "심사 철회 — 편집 가능한 상태로 되돌린다"
  lane :withdraw_review do
    api_key = load_asc_api_key
    app = asc_app(api_key)

    edit = edit_version(app)
    UI.user_error!("편집 중 버전이 없습니다 — 철회할 심사가 없습니다.") if edit.nil?

    state = edit.app_store_state
    if EDITABLE_STATES.include?(state)
      UI.important("#{edit.version_string}은(는) 이미 '#{state}' — 철회할 것이 없습니다.")
      next
    end

    UI.message("#{edit.version_string} (#{state}) 심사를 철회합니다…")

    # app.reject_version_if_possible!를 쓰지 않는 이유:
    # 그 경로는 AppStoreVersionSubmission#can_reject를 보는데 Apple이 이 필드를 더 이상
    # 돌려주지 않아 nil이 온다(실측). fastlane은 nil을 falsy로 보고 막아버린다.
    # 실제 철회는 제출 객체 DELETE — ASC API v1의 문서화된 방법이라 직접 호출한다.
    submission = begin
      edit.fetch_app_store_version_submission
    rescue StandardError => e
      UI.user_error!("제출 객체를 찾을 수 없습니다(#{e.class}) — 이미 내려갔을 수 있습니다.")
    end
    UI.user_error!("제출 객체가 없습니다 — 철회할 심사가 없습니다.") if submission.nil?

    begin
      submission.delete!
    rescue StandardError => e
      UI.user_error!(
        "철회 실패(#{e.class}: #{e.message}) → ASC에서 '심사에서 제거'를 직접 누르세요."
      )
    end
    UI.success("심사 철회 완료 — 상태 반영에 몇 초 걸린다(asc_state로 확인)")
  end

  # ── 상태 진단 ─────────────────────────────────────────────────
  # 버전·심사 단계·선택된 빌드·스크린샷을 한 번에 본다. 막혔을 때 첫 명령.
  desc "심사 상태 + 선택된 빌드 + 스크린샷 조회"
  lane :asc_state do
    api_key = load_asc_api_key
    app = asc_app(api_key)

    live = app.get_live_app_store_version
    UI.message("라이브(승인본): #{live ? live.version_string : '없음'}")
    UI.message("pubspec:        #{pubspec_version_name}")

    edit = edit_version(app)
    if edit.nil?
      UI.important("편집 중 버전 없음 — release가 #{pubspec_version_name} 페이지를 자동 생성합니다.")
      next
    end

    UI.success("편집 중 버전: #{edit.version_string}")
    # app_store_state는 구 필드, app_version_state가 현재 필드다. 둘이 어긋날 수 있어
    # 둘 다 찍는다(어긋나면 app_version_state를 믿는다).
    UI.message("상태:         #{edit.app_store_state}")
    UI.message("버전 상태:    #{edit.app_version_state.inspect}")
    sub = begin
      edit.fetch_app_store_version_submission
    rescue StandardError
      nil
    end
    UI.message("제출 객체:    #{sub ? '있음 (심사 대기열에 있음)' : '없음 (제출 안 됨)'}")
    editable = EDITABLE_STATES.include?(edit.app_store_state)
    UI.message("편집 가능:    #{editable ? '예' : '아니오 — 심사 진행 중(withdraw_review로 철회)'}")

    selected = begin
      edit.build
    rescue StandardError
      nil
    end
    UI.message("선택된 빌드:  #{selected ? "v#{selected.version}" : '없음'}")

    # 스토어 문구가 리포와 어긋나는지 — release가 맞춰주지만 미리 보여준다.
    begin
      desc = extract_store_text("docs/app_store_description.md", "App Store 설명", 400)
      notes = extract_store_text("docs/app_review_notes.md", "심사 메모", 200)
      edit.get_app_store_version_localizations.each do |loc|
        same = loc.description.to_s.strip == desc
        UI.message("설명 #{loc.locale}:   #{same ? '리포와 일치' : '⚠️ 리포와 다름 (release가 갱신)'}")
      end
      detail = edit.fetch_app_store_review_detail
      same = detail.notes.to_s.strip == notes
      UI.message("심사 메모:    #{same ? '리포와 일치' : '⚠️ 리포와 다름 (release가 갱신)'}")
    rescue StandardError => e
      UI.important("스토어 문구 비교 실패: #{e.class}")
    end

    each_screenshot_set(edit) do |loc, st, shots|
      dupes = shots.map(&:file_name).tally.select { |_, n| n > 1 }.keys
      suffix = dupes.empty? ? "" : "  ⚠️ 중복: #{dupes.join(', ')}"
      UI.message("스크린샷:     #{loc.locale} / #{st.screenshot_display_type} #{shots.count}장#{suffix}")
    end
  end

  desc "최근 TestFlight 빌드 처리 상태"
  lane :check_builds do
    api_key = load_asc_api_key
    app = asc_app(api_key)
    Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 5, sort: "-uploadedDate").each do |b|
      UI.message("  v#{b.version} (#{b.processing_state}) — uploaded #{b.uploaded_date}")
    end
  end

end
