default_platform(:ios)

# ── 공통 헬퍼 ──
# 함정 #6 회피: 통합 테스트(시뮬 빌드)가 남긴 native_assets 시뮬 슬라이스가
# 디바이스 IPA에 묶이면 altool 91169("Simulator platforms aren't permitted")로
# 거부된다. flutter clean + Pods/build 제거로 캐시를 비우고, 이어지는
# `flutter build ipa`가 pub get + pod install을 재수행해 클린 재구성한다.
# (바로팀과 달리 공직플랜은 flutter build ipa가 pod install을 직접 처리하므로
#  명시적 pod install·GEM unset(#7)은 불필요.)
def reset_ios_caches
  UI.header("iOS 캐시 정리 — 시뮬 슬라이스 방지 (함정 #6)")
  # __dir__ = ios/fastlane → 두 단계 위가 프로젝트 루트.
  project_root = File.expand_path("../..", __dir__)
  Dir.chdir(project_root) do
    sh("flutter", "clean")
    sh("rm", "-rf", "ios/Pods", "ios/Podfile.lock", "ios/build")
  end
end

# pubspec.yaml의 versionString(X.Y.Z) 파싱. 빌드 이름은 이 값을 그대로 쓴다
# (레인이 --build-name을 안 넘기므로 flutter가 pubspec 버전을 사용).
def pubspec_version_name
  project_root = File.expand_path("../..", __dir__)
  pubspec = File.read(File.join(project_root, "pubspec.yaml"))
  match = pubspec.match(/^version:\s*(\d+\.\d+\.\d+)/)
  UI.user_error!("pubspec.yaml에서 version을 찾을 수 없습니다") unless match
  match[1]
end

# ASC에 편집 가능한 버전 페이지를 보장한다.
#
# 없으면 만든다. minor/major를 올릴 때는 항상 없으므로, 이걸 자동화하지 않으면 매번
# 사람이 ASC에서 '+ 버전 또는 플랫폼'을 눌러야 한다. patch에서는 기존 페이지가 남아
# 있어 그냥 통과한다.
def ensure_edit_version(app, version_string)
  edit = begin
    app.get_edit_app_store_version
  rescue StandardError
    nil
  end
  return edit if edit

  UI.message("편집 가능한 버전 없음 → #{version_string} 페이지를 생성합니다")
  app.ensure_version!(version_string, platform: Spaceship::ConnectAPI::Platform::IOS)

  edit = begin
    app.get_edit_app_store_version
  rescue StandardError
    nil
  end
  if edit.nil?
    UI.user_error!(
      "#{version_string} 버전 페이지 생성에 실패했습니다. ASC에서 직접 만든 뒤 재실행하세요."
    )
  end
  UI.success("버전 페이지 생성: #{edit.version_string}")
  edit
end

# "이번 버전의 새로운 기능"을 docs/release_notes/<버전>.ko.txt에서 넣는다.
# Apple이 업데이트 심사에 필수로 요구하는 항목이라, 비어 있으면 제출이 막힌다.
def apply_release_notes(edit, version_string)
  project_root = File.expand_path("../..", __dir__)
  path = File.join(project_root, "docs/release_notes/#{version_string}.ko.txt")

  unless File.exist?(path)
    UI.user_error!(
      "가드 E: 릴리즈 노트가 없습니다 → docs/release_notes/#{version_string}.ko.txt " \
      "Apple이 '이번 버전의 새로운 기능'을 필수로 요구합니다. " \
      "docs/release_notes/README.md 참고."
    )
  end

  notes = File.read(path).strip
  UI.user_error!("릴리즈 노트가 비어 있습니다: #{path}") if notes.empty?

  locs = edit.get_app_store_version_localizations
  if locs.empty?
    UI.user_error!("버전 로컬라이제이션이 없습니다. ASC에서 언어 설정을 확인하세요.")
  end
  locs.each do |loc|
    loc.update(attributes: { whats_new: notes })
    UI.message("릴리즈 노트 입력: #{loc.locale} (#{notes.lines.count}줄)")
  end
  UI.success("릴리즈 노트 반영 완료")
end

def next_patch(version)
  parts = version.split(".").map(&:to_i)
  parts[2] = (parts[2] || 0) + 1
  parts.join(".")
end

# 함정 #5 선제 차단: pubspec versionString이 App Store 승인본(현재 판매 중 버전)
# 이하이면 그 train이 닫혀 있어 altool이 업로드를 거부한다(90062/90186).
# clean 빌드(수 분) + 업로드까지 다 돌린 뒤 거부당하는 낭비를 막으려고,
# 빌드 전에 즉시 NO-GO로 중단한다. 버전 자동 증가는 하지 않는다 — 증가폭은 사람 판단.
def assert_version_bumped(api_key)
  require 'spaceship'
  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
  app = Spaceship::ConnectAPI::App.find("com.planroutine.app")
  live = app&.get_live_app_store_version
  local = pubspec_version_name

  # 승인본이 아직 없으면(최초 출시 전) 가드 통과.
  if live.nil?
    UI.message("App Store 승인본 없음 — 버전 가드 통과 (pubspec #{local})")
    return
  end

  approved = live.version_string
  if Gem::Version.new(local) > Gem::Version.new(approved)
    UI.success("버전 가드 통과: pubspec #{local} > 승인본 #{approved}")
  else
    UI.user_error!(
      "pubspec 버전 #{local}이(가) App Store 승인본 #{approved} 이하입니다. " \
      "이 train은 닫혀 있어 업로드가 거부됩니다(함정 #5). " \
      "빌드 전 중단 — pubspec.yaml의 version을 올리세요 (예: #{next_patch(approved)})."
    )
  end
end

platform :ios do

  # ── App Store Connect API Key 인증 ──
  desc "App Store Connect API Key 로드"
  lane :load_asc_api_key do
    app_store_connect_api_key(
      key_id: "D8W86CLKHY",
      issuer_id: "69a6de72-97eb-47e3-e053-5b8c7c11a4d1",
      key_filepath: File.expand_path("~/.appstoreconnect/private_keys/AuthKey_D8W86CLKHY.p8"),
    )
  end

  # ── TestFlight 배포 ──
  desc "TestFlight에 새 빌드 업로드"
  lane :beta do
    api_key = load_asc_api_key

    # 함정 #5 선제 차단: 승인본 이하 버전이면 clean 빌드 전에 중단
    assert_version_bumped(api_key)

    # 빌드 번호 자동 증가 (TestFlight 최신 빌드 + 1)
    latest = latest_testflight_build_number(
      app_identifier: "com.planroutine.app",
    )
    new_build_number = latest + 1
    UI.message("빌드 번호: #{latest} → #{new_build_number}")

    reset_ios_caches

    # Flutter 빌드
    Dir.chdir("..") do
      sh("flutter", "build", "ipa",
        "--release",
        "--build-number=#{new_build_number}",
      )
    end

    # IPA 파일명이 한글(공직플랜.ipa)이라 Ruby Dir[] glob이 매치 못함. Dir.entries로
    # 직접 순회해 찾는다. 파일명이 또 바뀌어도 깨지지 않는다.
    # __dir__ = ios/fastlane → 두 단계 올라가 프로젝트 루트.
    project_root = File.expand_path("../..", __dir__)
    ipa_dir = File.join(project_root, "build/ios/ipa")
    ipa_name = Dir.entries(ipa_dir).find { |f| f.end_with?(".ipa") }
    UI.user_error!("빌드된 IPA를 찾을 수 없습니다 (#{ipa_dir})") unless ipa_name
    ipa_path = File.join(ipa_dir, ipa_name)

    upload_to_testflight(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true,
    )

    UI.success("TestFlight 배포 완료! v#{new_build_number}")
  end

  # ── App Store 배포 (promote 전용 — beta 선행 필요) ──
  # 바이너리를 새로 빌드/업로드하지 않는다. beta로 이미 올려 TestFlight에서 검증한
  # 최신 빌드를 그대로 승격(promote)하고 심사 자동 제출 + 승인 시 자동 공개한다.
  # (재빌드·재업로드 없음 → 업로드 중단 함정 회피, ASC 수동 단계 제거.)
  desc "App Store에 최신 TestFlight 빌드 승격 + 심사 제출"
  # ── App Store 심사 제출 (promote 전용) ────────────────────────
  #
  #   fastlane ios release                  최신 빌드 승격 + 심사 제출
  #   fastlane ios release build:115        승격할 빌드를 못박음(검증한 빌드 지정)
  #   fastlane ios release submit:false     빌드만 붙이고 제출은 ASC에서 수동
  #
  # 재빌드/재업로드가 없다 — 실기기로 검증한 그 바이너리가 그대로 심사에 간다.
  lane :release do |options|
    api_key = load_asc_api_key

    # 가드 A(함정 #5): pubspec versionString이 승인본 이하이면 중단
    assert_version_bumped(api_key)

    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find("com.planroutine.app")

    # 편집 가능한 버전 페이지 보장(없으면 생성).
    # 없는 채로 upload_to_app_store에 들어가면 fastlane 2.233.0이 sync_app_previews에서
    # NoMethodError로 죽어 원인을 읽을 수 없다.
    edit = ensure_edit_version(app, pubspec_version_name)

    # 가드 D: 이미 심사 단계면 손대지 않는다.
    # submit_for_review로 제출된 버전을 다시 건드리면 심사가 되돌려진다.
    # 수동 제출 후 실수로 release를 돌리는 경우를 막는 가드.
    editable_states = %w[
      PREPARE_FOR_SUBMISSION
      DEVELOPER_REJECTED
      REJECTED
      METADATA_REJECTED
    ]
    state = edit.app_store_state
    unless editable_states.include?(state)
      UI.user_error!(
        "가드 D: #{edit.version_string}이(가) 이미 '#{state}' 상태입니다. " \
        "지금 release를 실행하면 진행 중인 심사가 되돌려질 수 있습니다. " \
        "이미 제출됐다면 아무것도 하지 마세요. 되돌리려면 ASC에서 제출을 취소한 뒤 재실행."
      )
    end
    UI.success("가드 D 통과: #{edit.version_string} (#{state})")

    # 릴리즈 노트(가드 E) — 없으면 여기서 중단된다.
    apply_release_notes(edit, edit.version_string)

    # 승격 대상 결정.
    # 빌드를 명시하면 그것만 쓴다 — "최신"에 맡기면 검증 후 beta를 한 번 더 돌렸을 때
    # 테스트하지 않은 빌드가 심사에 올라간다.
    target =
      if options[:build]
        options[:build].to_s.to_i
      else
        latest_testflight_build_number(
          app_identifier: "com.planroutine.app",
          version: edit.version_string,
        )
      end
    UI.message("승격 대상: build #{target} (#{edit.version_string})")

    # 가드 B: 그 빌드가 ASC에 VALID로 존재해야 promote 가능.
    # 방금 beta로 올렸으면 처리(40~60분)가 끝나야 VALID가 된다.
    builds = Spaceship::ConnectAPI::Build.all(
      app_id: app.id, limit: 20, sort: "-uploadedDate",
    )
    unless builds.any? { |b| b.version.to_i == target && b.processing_state == "VALID" }
      UI.user_error!(
        "가드 B: build #{target}이 App Store Connect에 VALID로 없습니다(처리 중일 수 있음). " \
        "먼저 `beta`로 올리고 처리 완료(check_builds에서 VALID 확인) 후 재실행하세요."
      )
    end

    # submit:false면 빌드만 붙이고 제출은 사람이 ASC에서 한다.
    submit = !%w[false no 0].include?(options[:submit].to_s.downcase)

    upload_to_app_store(
      api_key: api_key,
      build_number: target.to_s,
      skip_binary_upload: true,   # 재업로드 없음 — 기존 빌드 승격만
      skip_metadata: true,        # App Store 리스팅 메타데이터는 ASC에서 수동 관리
      skip_screenshots: true,
      submit_for_review: submit,
      automatic_release: true,    # 승인 시 자동 공개
      force: true,                # HTML 미리보기 확인 스킵(비대화형)
      # precheck는 ASC API Key로 IAP 확인이 안 돼 에러가 난다 → 끈다.
      run_precheck_before_submit: false,
      precheck_include_in_app_purchases: false,
      # 암호화/IDFA 심사 질문 자동 응답.
      submission_information: {
        export_compliance_uses_encryption: false,
        add_id_info_uses_idfa: false,
      },
    )

    if submit
      UI.success("App Store 심사 제출 완료! v#{target} — 승인 시 자동 공개")
    else
      UI.success("빌드 v#{target} 연결 완료 — 제출은 ASC에서 직접 하세요")
    end
  end

  # ── 심사/버전 상태 조회 ───────────────────────────────────────
  # check_builds는 '빌드'만 보여준다. 심사가 어느 단계인지, 어떤 빌드가 붙어 있는지는
  # 여기서 본다. release가 왜 막혔는지 진단하는 첫 명령.
  lane :asc_state do
    api_key = load_asc_api_key
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find("com.planroutine.app")

    live = app.get_live_app_store_version
    UI.message("라이브(승인본): #{live ? live.version_string : '없음'}")
    UI.message("pubspec:        #{pubspec_version_name}")

    edit = begin
      app.get_edit_app_store_version
    rescue StandardError => e
      UI.important("편집 버전 조회 실패: #{e.class}")
      nil
    end

    if edit.nil?
      UI.important("편집 가능한 버전이 없습니다.")
      UI.important("→ ASC에서 '+ 버전 또는 플랫폼'으로 #{pubspec_version_name} 페이지를 먼저 만들어야 release가 동작합니다.")
    else
      UI.success("편집 중 버전: #{edit.version_string}")
      UI.message("상태:         #{edit.app_store_state}")
      selected = begin
        edit.build
      rescue StandardError
        nil
      end
      UI.message("선택된 빌드:  #{selected ? "v#{selected.version}" : '없음'}")
    end
  end

  lane :check_builds do
    api_key = load_asc_api_key
    require 'spaceship'
    Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
    app = Spaceship::ConnectAPI::App.find("com.planroutine.app")
    UI.message("App ID: #{app.id}")
    builds = Spaceship::ConnectAPI::Build.all(app_id: app.id, limit: 5, sort: "-uploadedDate")
    builds.each do |b|
      UI.message("  v#{b.version} (#{b.processing_state}) — uploaded #{b.uploaded_date}")
    end
  end

end
